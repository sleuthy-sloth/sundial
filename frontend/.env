# Build-time settings for the app. Nothing secret belongs here — this file is committed.

# The public address this copy is served from, used to make the social-preview URLs absolute
# (see the og:image tags in index.html). Left empty, those URLs stay relative: a visitor's
# browser resolves them, a crawler will not, and the picture is simply not shown in a preview.
# Set it to your own host if you want link previews to work, and rebuild:
#
#     VITE_APP_URL=https://planner.example.com
#
# There is no default, deliberately: a self-hosted app has no canonical public URL, and a wrong
# one baked into the build is worse than a missing preview.
VITE_APP_URL=
