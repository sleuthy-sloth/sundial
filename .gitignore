node_modules/
dist/
backend/static/
__pycache__/
backend/*.db
backend/*.db-wal
backend/*.db-shm
.venv/
*.log

# calendar credentials — never commit these
icloud.env
google.json
# the identity the app generates for itself the first time it has something to notify
vapid.env

# a deployment's own address (VITE_APP_URL) lives here, not in the committed .env: the repo is
# public and this box's hostname is not something to publish
frontend/.env.local

# a snapshot failure writes the shot it saw here for inspection
frontend/e2e/baselines/*.current.png
